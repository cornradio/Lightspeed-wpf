<Window x:Class="Lightspeed_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lightspeed_wpf"
        Title="Lightspeed" 
        Height="800" Width="500"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        StateChanged="Window_StateChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <Style x:Key="FolderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="#22FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarFolderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#52FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                    Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path x:Name="check" Data="M3,9 L7,13 L15,4" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" Margin="1"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#3D7CF5"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#3D7CF5"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#18FFFFFF" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333D7CF5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption buttons: vector glyphs, equal hit targets -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}"/>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionCloseButtonStyle}"/>

        <Style x:Key="ViewToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="underline" Height="2" VerticalAlignment="Bottom" Background="#AAFFFFFF" CornerRadius="1" Margin="6,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListViewItem" x:Key="FileListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding JustOpened}" Value="True">
                    <Setter Property="Background" Value="#442E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="IconListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding JustOpened}" Value="True">
                    <Setter Property="Background" Value="#442E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#66FFFFFF" CornerRadius="4" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleThumbStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleThumbStyle}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleThumbStyle}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowBorder" BorderThickness="0" BorderBrush="Transparent" Background="Transparent">
    <Border x:Name="RootChrome"
            Background="#CC1A1A1A"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Margin="6"
            ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" x:Name="TitleBarGrid" Height="36" Margin="8,6,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Lightspeed" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12"/>

            <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Btn0" Content="0" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn1" Content="1" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn2" Content="2" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn3" Content="3" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn4" Content="4" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn5" Content="5" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn6" Content="6" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn7" Content="7" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn8" Content="8" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                    <Button x:Name="Btn9" Content="9" Style="{StaticResource TitleBarFolderButtonStyle}" Click="FolderButton_Click"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnSearch" Content="🔍" Style="{StaticResource SideButtonStyle}" Click="BtnSearch_Click" ToolTip="搜索 (Ctrl+P)" Height="26" Width="28" FontSize="12" Margin="0,0,4,0"/>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="最小化">
                    <Path Data="M0,0.5 L10,0.5" Stroke="#CCFFFFFF" StrokeThickness="1.2" Width="10" Height="1"
                          Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="最大化">
                    <Path x:Name="MaximizeIcon" Data="M1,1 H9 V9 H1 Z" Stroke="#CCFFFFFF" StrokeThickness="1.2"
                          Width="10" Height="10" Stretch="None"/>
                </Button>
                <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="CloseButton_Click" ToolTip="关闭 (Shift+点击退出)">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="White" StrokeThickness="1.2" Width="8" Height="8"
                          Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" AllowDrop="True" Drop="Grid_Drop" DragOver="Grid_DragOver" Margin="6,4,6,0">
            <ListView x:Name="FileListView" 
                      Background="Transparent" 
                      Foreground="White"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileListView_MouseRightClick"
                      Visibility="Visible">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource FileListViewItem}"/>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="{Binding IconMargin}" RenderOptions.BitmapScalingMode="Fant"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" FontSize="{Binding LabelFontSize}" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <TextBox x:Name="EditTextBox" Grid.Column="1" VerticalAlignment="Center" Background="#33FFFFFF" Foreground="White" FontSize="{Binding LabelFontSize}" BorderThickness="0" Padding="4,2" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" LostFocus="EditTextBox_LostFocus" PreviewKeyDown="EditTextBox_PreviewKeyDown"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListBox x:Name="IconListView" 
                      Background="Transparent" 
                      Foreground="White"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="IconListView_MouseDoubleClick"
                      PreviewMouseRightButtonDown="IconListView_MouseRightClick"
                      Visibility="Collapsed">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource IconListBoxItem}">
                        <Setter Property="Width" Value="100"/>
                        <Setter Property="MinHeight" Value="100"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding Icon}"
                                   Width="{Binding IconSize}"
                                   Height="{Binding IconSize}"
                                   Margin="{Binding IconMargin}"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="Fant"/>
                            <TextBlock Text="{Binding Name}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       FontSize="{Binding LabelFontSize}"
                                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <TextBox TextAlignment="Center"
                                     TextWrapping="Wrap"
                                     Background="#33FFFFFF"
                                     Foreground="White"
                                     FontSize="{Binding LabelFontSize}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                     LostFocus="EditTextBox_LostFocus"
                                     PreviewKeyDown="EditTextBox_PreviewKeyDown"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

        <Border Grid.Row="2" x:Name="BottomBarBorder" Background="#14FFFFFF" Padding="8,4" Margin="8,4,8,8" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnGamepadToggle" Content="🎮" IsChecked="True" Click="BtnGamepadToggle_Click" Height="26" Width="30" Margin="2,0" Background="Transparent" Foreground="#99FFFFFF" BorderThickness="0" FontSize="14" ToolTip="手柄控制开关">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button Content="📁" Style="{StaticResource SideButtonStyle}" Click="BtnOpenInExplorer_Click" />
                    <Button Content="↻" Style="{StaticResource SideButtonStyle}" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnQuickStart" Content="⚡" Style="{StaticResource SideButtonStyle}" Click="BtnQuickStartAHK_Click" ToolTip="启动快速启动（按当前模式）"/>
                </StackPanel>
                
                <TextBlock x:Name="TxtFolderName" Grid.Column="1"
                           Text="" Foreground="#88FFFFFF" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnListView" Content="L" Style="{StaticResource ViewToggleButtonStyle}" IsChecked="True" Click="BtnListView_Click"/>
                    <ToggleButton x:Name="BtnIconView" Content="G" Style="{StaticResource ViewToggleButtonStyle}" IsChecked="False" Click="BtnIconView_Click"/>
                    <ToggleButton x:Name="BtnSettings" Content="⋮" Click="BtnSettings_Click" Height="26" Width="30" Margin="2,0" Background="Transparent" Foreground="#99FFFFFF" BorderThickness="0" FontSize="16">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

            <Border x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
                    Background="#99000000"
                    Visibility="Collapsed"
                    PreviewMouseLeftButtonDown="SettingsPanel_PreviewMouseLeftButtonDown">
                <Border x:Name="SettingsDialog"
                        Width="520"
                        MaxWidth="560"
                        MinHeight="280"
                        MaxHeight="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F01C1C1F"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Margin="24"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,16,12,8">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="设置" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="调整启动、显示与快捷键偏好" Style="{StaticResource SettingsHintStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource CaptionCloseButtonStyle}"
                                    Width="32" Height="28" Margin="0"
                                    Click="BtnCloseSettings_Click" ToolTip="关闭设置">
                                <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="White" StrokeThickness="1.2" Width="8" Height="8"
                                      Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" Padding="20,0,20,16" Margin="0,0,0,4">
                            <StackPanel>
                        <!-- General -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="通用" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <CheckBox x:Name="ChkAutoStartWithWindows" Content="开机自启动" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ChkAutoStartWithWindows_Changed" Unchecked="ChkAutoStartWithWindows_Changed"/>
                                <CheckBox x:Name="ChkTouchMode" Content="触控模式（顶部 / 底部栏放大 2 倍）" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ChkTouchMode_Changed" Unchecked="ChkTouchMode_Changed"/>
                                <TextBlock Text="托盘图标单击" Style="{StaticResource SettingsLabelStyle}" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbTrayMain" Content="打开主界面" Style="{StaticResource SettingsRadioStyle}" GroupName="TrayClick" Checked="RbTrayClick_Changed" Tag="0"/>
                                    <RadioButton x:Name="RbTraySearch" Content="打开搜索页面" Style="{StaticResource SettingsRadioStyle}" GroupName="TrayClick" Checked="RbTrayClick_Changed" Tag="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="快捷键" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="唤起主窗口" Foreground="#88FFFFFF" FontSize="11"/>
                                        <TextBlock x:Name="TxtHotkey" Text="Alt+S" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="修改" Click="BtnCaptureHotkey_Click" Style="{StaticResource SettingsButtonStyle}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="搜索" Foreground="#88FFFFFF" FontSize="11"/>
                                        <TextBlock x:Name="TxtSearchHotkey" Text="Alt+Shift+Space" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="修改" Click="BtnCaptureSearchHotkey_Click" Style="{StaticResource SettingsButtonStyle}" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox x:Name="ChkDisableInFullscreen" Content="全屏程序中禁用快捷键" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ChkDisableInFullscreen_Changed" Unchecked="ChkDisableInFullscreen_Changed"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="手柄快捷键" Foreground="#88FFFFFF" FontSize="11"/>
                                        <TextBlock x:Name="TxtGamepadHotkey" Text="未设置" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="录入" Click="BtnCaptureGamepadHotkey_Click" Style="{StaticResource SettingsButtonStyle}"/>
                                        <Button Content="清除" Click="BtnClearGamepadHotkey_Click" Style="{StaticResource SettingsGhostButtonStyle}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="点击录入，同时按下至少 3 个键（支持 LT/RT 与方向键）" Style="{StaticResource SettingsHintStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick launch -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="快速启动" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <TextBlock Text="快捷键仅在桌面或任务栏获得焦点时生效，避免在其他应用中误触。" Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton x:Name="RbQuickLaunchOff" Content="关闭" Style="{StaticResource SettingsRadioStyle}" GroupName="QuickLaunch" Checked="RbQuickLaunchMode_Changed" Tag="0"/>
                                    <RadioButton x:Name="RbQuickLaunchAHK" Content="AutoHotkey" Style="{StaticResource SettingsRadioStyle}" GroupName="QuickLaunch" Checked="RbQuickLaunchMode_Changed" Tag="1"/>
                                    <RadioButton x:Name="RbQuickLaunchNative" Content="程序本体" Style="{StaticResource SettingsRadioStyle}" GroupName="QuickLaunch" Checked="RbQuickLaunchMode_Changed" Tag="2"/>
                                </StackPanel>
                                <Button Content="创建文件夹" Style="{StaticResource SettingsButtonStyle}" Click="BtnCreateFolders_Click" HorizontalAlignment="Left"/>
                                <StackPanel x:Name="PanelAhkControls" Margin="0,4,0,0">
                                    <WrapPanel>
                                        <Button Content="生成 AHK" Style="{StaticResource SettingsButtonStyle}" Click="BtnGenerateAHK_Click"/>
                                        <Button Content="启动 AHK" Style="{StaticResource SettingsButtonStyle}" Click="BtnStartAHK_Click"/>
                                        <Button Content="生成并启动" Style="{StaticResource SettingsButtonStyle}" Click="BtnGenerateAndStart_Click"/>
                                    </WrapPanel>
                                    <TextBlock Margin="0,4,0,0">
                                        <Hyperlink NavigateUri="https://kasusa.lanzoul.com/iClHk28thruj" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#99B4FF">
                                            下载 AHK（懒人包）
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel x:Name="PanelNativeControls" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="Alt+0~9 打开文件夹；按住数字再按文件名首字母启动。启动时显示图标 HUD。" Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,10"/>
                                    <Button Content="重新加载快捷键绑定" Style="{StaticResource SettingsButtonStyle}" Click="BtnReloadNativeBindings_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Display -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="显示" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <CheckBox x:Name="ChkHideDesktopIni" Content="隐藏 desktop.ini 文件" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ChkHideDesktopIni_Changed" Unchecked="ChkHideDesktopIni_Changed"/>
                                <CheckBox x:Name="ChkHideExtensions" Content="隐藏文件扩展名" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ChkHideExtensions_Changed" Unchecked="ChkHideExtensions_Changed"/>
                                <CheckBox x:Name="ChkSingleClickOpen" Content="单击打开文件 / 文件夹" Style="{StaticResource SettingsCheckBoxStyle}" Checked="ChkSingleClickOpen_Changed" Unchecked="ChkSingleClickOpen_Changed"/>

                                <TextBlock Text="弹窗提示位置" Style="{StaticResource SettingsLabelStyle}" Margin="0,8,0,8"/>
                                <UniformGrid Columns="3" Rows="2" Width="320" HorizontalAlignment="Left">
                                    <RadioButton x:Name="RbToastPos1" Content="左上" Style="{StaticResource SettingsRadioStyle}" GroupName="ToastPos" Checked="RbToastPosition_Changed" Tag="1"/>
                                    <RadioButton x:Name="RbToastPos0" Content="正上" Style="{StaticResource SettingsRadioStyle}" GroupName="ToastPos" Checked="RbToastPosition_Changed" Tag="0"/>
                                    <RadioButton x:Name="RbToastPos2" Content="右上" Style="{StaticResource SettingsRadioStyle}" GroupName="ToastPos" Checked="RbToastPosition_Changed" Tag="2"/>
                                    <RadioButton x:Name="RbToastPos4" Content="左下" Style="{StaticResource SettingsRadioStyle}" GroupName="ToastPos" Checked="RbToastPosition_Changed" Tag="4"/>
                                    <RadioButton x:Name="RbToastPos3" Content="正下" Style="{StaticResource SettingsRadioStyle}" GroupName="ToastPos" Checked="RbToastPosition_Changed" Tag="3"/>
                                    <RadioButton x:Name="RbToastPos5" Content="右下" Style="{StaticResource SettingsRadioStyle}" GroupName="ToastPos" Checked="RbToastPosition_Changed" Tag="5"/>
                                </UniformGrid>
                                <TextBlock Text="同时作用于主窗口 Toast 与快速启动 HUD" Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="图标大小（列表）" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Slider x:Name="SliderIconSize" Width="220" Minimum="16" Maximum="64" Value="30" VerticalAlignment="Center" ValueChanged="SliderIconSize_ValueChanged"/>
                                    <TextBox x:Name="TxtIconSize" Width="48" Margin="12,0,0,0" Style="{StaticResource SettingsTextBoxStyle}" TextAlignment="Center" Text="30" LostFocus="TxtIconSize_LostFocus" KeyDown="TxtIconSize_KeyDown"/>
                                </StackPanel>

                                <TextBlock Text="图标大小（网格）" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Slider x:Name="SliderIconSizeIcon" Width="220" Minimum="16" Maximum="128" Value="60" VerticalAlignment="Center" ValueChanged="SliderIconSizeIcon_ValueChanged"/>
                                    <TextBox x:Name="TxtIconSizeIcon" Width="48" Margin="12,0,0,0" Style="{StaticResource SettingsTextBoxStyle}" TextAlignment="Center" Text="60" LostFocus="TxtIconSizeIcon_LostFocus" KeyDown="TxtIconSizeIcon_KeyDown"/>
                                </StackPanel>

                                <TextBlock Text="窗口大小模式" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbWindowMode0" Content="长条模式" Style="{StaticResource SettingsRadioStyle}" GroupName="WindowSize" Checked="RbWindowMode_Changed" Tag="0"/>
                                    <RadioButton x:Name="RbWindowMode1" Content="宽胖模式" Style="{StaticResource SettingsRadioStyle}" GroupName="WindowSize" Checked="RbWindowMode_Changed" Tag="1"/>
                                    <RadioButton x:Name="RbWindowMode2" Content="自定义" Style="{StaticResource SettingsRadioStyle}" GroupName="WindowSize" Checked="RbWindowMode_Changed" Tag="2"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelCustomSize" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                    <TextBlock Text="W" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtCustomWidth" Width="72" Style="{StaticResource SettingsTextBoxStyle}" TextAlignment="Center" LostFocus="TxtCustomSize_LostFocus"/>
                                    <TextBlock Text="H" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                    <TextBox x:Name="TxtCustomHeight" Width="72" Style="{StaticResource SettingsTextBoxStyle}" TextAlignment="Center" LostFocus="TxtCustomSize_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Aliases -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="文件夹别名" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <TextBlock Text="悬停数字按钮时显示；仅保存在配置中，不改文件夹名。留空则显示实际名称。" Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                        <TextBlock Text="0" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias0" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="1" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias1" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="1"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                        <TextBlock Text="2" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias2" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="2"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="3" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias3" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="3"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                        <TextBlock Text="4" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias4" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="5" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias5" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                        <TextBlock Text="6" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias6" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="6"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="7" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias7" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="8" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias8" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="8"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="9" Foreground="#88FFFFFF" Width="18" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TxtAlias9" Width="150" Style="{StaticResource SettingsTextBoxStyle}" LostFocus="TxtAlias_LostFocus" Tag="9"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="关于" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="版本" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtVersion" Text="-" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="检查更新" Margin="14,0,0,0" Click="BtnCheckUpdate_Click" Style="{StaticResource SettingsButtonStyle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtUpdateStatus" Text="" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="10,0,0,8"/>
                                </StackPanel>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://lightspeed.cornradio.org/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#99B4FF">
                                        lightspeed.cornradio.org
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

        <Popup x:Name="AliasPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=TitleBarGrid}"
               HorizontalOffset="0"
               VerticalOffset="-8"
               AllowsTransparency="True"
               IsOpen="False">
            <Border Background="#CC1A1A1A"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,6"
                    MaxWidth="400">
                <TextBlock x:Name="TxtAliasOverlay"
                           Text=""
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
        </Popup>

        <Grid x:Name="ToastHost"
              Grid.Row="0" Grid.RowSpan="3"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="16"
              IsHitTestVisible="False">
            <Border x:Name="ToastBar"
                    Background="#CC1A1A1A"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,10"
                    Visibility="Collapsed"
                    Opacity="0">
                <TextBlock x:Name="ToastText"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
    </Border>
    </Border>
</Window>
